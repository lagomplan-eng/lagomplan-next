# Lagomplan — environment variables. Copy to .env.local and fill in.
# Never commit real values. In Vercel, set each var for Production AND every
# Preview (incl. feature-branch previews), not just "Preview (main)".

# ── Site ─────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SAMPLE_TRIP_ID=

# ── Supabase ─────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_FUNCTION_URL=
# Server-side only (admin client, rate limiting, webhooks)
SUPABASE_SERVICE_ROLE_KEY=

# ── Google Maps ──────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# ── Stripe (server-side; use TEST keys outside production) ───
STRIPE_MODE=
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_TRIP_1=
STRIPE_PRICE_TRIP_5=
STRIPE_PRICE_TRIP_10=
STRIPE_PRICE_EXPLORER=

# ── Mailchimp (server-side only) ─────────────────────────────
# API key format: <key>-<datacenter>, e.g. "abc123def456-us13"
MAILCHIMP_API_KEY=
# Audience / List ID
MAILCHIMP_LIST_ID=
# Optional: tag applied by /api/subscribe (newsletter popup)
MAILCHIMP_TAG=
# NEW (lead magnet): unsubscribe URL used in the email footer and the
# List-Unsubscribe header (Mailchimp audience's unsubscribe link)
MAILCHIMP_UNSUB_URL=

# ── Resend (transactional email) ─────────────────────────────
# Used by /api/contact and the lead-magnet delivery email (/api/lead-magnet).
# Requires lagomplan.com to be verified in Resend to send from elena@lagomplan.com.
RESEND_API_KEY=
# NEW (lead magnet): postal address printed in the email footer
LAGOMPLAN_POSTAL_ADDRESS=

# ── Analytics ────────────────────────────────────────────────
# Leave blank locally so dev traffic doesn't pollute production analytics.
NEXT_PUBLIC_GA_MEASUREMENT_ID=
GA_API_SECRET=
NEXT_PUBLIC_META_PIXEL_ID=

# ── Consent / privacy ────────────────────────────────────────
# Pepper for hashing IPs (consent log + lead-magnet rate limiting). Set in prod.
CONSENT_IP_SALT=

# ── Cron ─────────────────────────────────────────────────────
CRON_SECRET=

# ── Supabase Edge Functions (set via `supabase secrets set`) ─
# ANTHROPIC_API_KEY, GENERATE_TRIP_MODEL, GENERATE_TRIP_DAY_MODEL,
# SKELETON_MODEL, LEGACY_ANON_KEY
